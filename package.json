{
  "name": "jupyter-watches",
  "author": "lumine-code",
  "description": "Watch expressions re-evaluated after every kernel execution.",
  "repository": "https://github.com/lumine-code/jupyter-watches",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-watches/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-watches#readme",
  "keywords": [
    "expression",
    "monitor",
    "kernel",
    "repl",
    "history",
    "python"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "deserializers": {
    "jupyter-watches/WatchesPane": "deserializeWatchesPane"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "configSchema": {
    "keepOpen": {
      "title": "Leave panel open",
      "description": "Do not close the panel when the current editor has no running kernel.",
      "type": "boolean",
      "default": true
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "mcp.tools": {
      "versions": {
        "1.0.0": "provideMcpTools"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    },
    "jupyter.output": {
      "versions": {
        "^1.0.0": "consumeJupyterOutput"
      }
    },
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "jupyter.context": {
      "versions": {
        "^1.0.0": "consumeJupyterContext"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#09b0556a819a3fd975130066ea5b408c2da25ce3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
